generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ProductType {
  COURSE
  SAMPLE_PACK
  LOOP
  TRACK
  BUNDLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  description     String
  price           Float
  salePrice       Float?
  type            ProductType
  category        String         // ej: "Trap", "Lo-Fi", "Mezcla", "Drums", "Piano"
  status          ProductStatus  @default(DRAFT)
  isFeatured      Boolean        @default(false)
  
  // Archivos Multimedia Públicos
  thumbnailUrl    String         // Carátula de la imagen
  previewAudioUrl String?        // Demo MP3 público para reproducción previa
  
  // Archivos Protegidos (entrega digital tras compra)
  downloadFileUrl String?        // URL privada al archivo ZIP/WAV maestro
  fileSize        String?        // ej: "450 MB", "1.2 GB"
  
  // Metadatos Musicales (Loops / Samples / Beats)
  bpm             Int?           // Tempo (ej: 140)
  key             String?        // Tonalidad (ej: "C Minor", "F# Major")
  formatInfo      String?        // ej: "24-bit WAV + MIDI Stems"
  
  // Relación con Cursos (solo aplica si type == COURSE)
  modules         CourseModule[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([type, status])
  @@index([category])
}

model CourseModule {
  id        String    @id @default(cuid())
  title     String
  order     Int       @default(0)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId])
}

model Lesson {
  id            String       @id @default(cuid())
  title         String
  videoUrl      String
  duration      Int?         // Duración en segundos
  isFreePreview Boolean      @default(false)
  order         Int          @default(0)
  moduleId      String
  module        CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([moduleId])
}
