// Prisma Schema for LMS & Music E-Commerce Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  COURSE
  SAMPLE_PACK
  LOOP
  TRACK
  BUNDLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id        String           @id @default(uuid())
  email     String           @unique
  name      String
  role      String           @default("STUDENT") // ADMIN, STUDENT, CUSTOMER
  createdAt DateTime         @default(now())
  progress  CourseProgress[]
  purchases Purchase[]
}

model Product {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  description     String
  price           Float
  salePrice       Float?
  type            ProductType
  category        String         // ej: "Trap", "Lo-Fi", "Mezcla", "Batería", "Piano"
  status          ProductStatus  @default(DRAFT)
  isFeatured      Boolean        @default(false)
  
  // Multimedia pública
  thumbnailUrl    String         // Carátula (JPG/PNG)
  previewAudioUrl String?        // Demo MP3 público (30-60 seg con reproductor)
  
  // Archivo protegido (solo accesible tras compra)
  downloadFileUrl String?        // URL privada al archivo ZIP/WAV en S3/Cloudflare R2
  fileSize        String?        // ej: "1.2 GB", "450 MB"
  
  // Metadatos específicos para Loops / Beats
  bpm             Int?           // ej: 140
  key             String?        // ej: "C Minor", "F# Major"
  formatInfo      String?        // ej: "50 WAV Loops + 20 MIDIs"
  
  // Relación con Cursos (solo aplica si type == COURSE)
  modules         CourseModule[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  purchases       Purchase[]
}

model CourseModule {
  id        String    @id @default(cuid())
  title     String
  order     Int
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id            String             @id @default(cuid())
  title         String
  videoUrl      String?
  content       String?
  duration      Int?               @default(0) // Duración en segundos
  isFreePreview Boolean            @default(false)
  order         Int
  moduleId      String
  module        CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attachments   LessonAttachment[]
  progress      CourseProgress[]
}

model LessonAttachment {
  id       String @id @default(cuid())
  title    String
  fileUrl  String
  fileType String // PDF, MIDI, PRESET, ZIP
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model CourseProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Purchase {
  id          String       @id @default(uuid())
  userId      String
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productType ProductType?
  amount      Float
  status      String       @default("COMPLETED") // COMPLETED, PENDING, REFUNDED
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}
